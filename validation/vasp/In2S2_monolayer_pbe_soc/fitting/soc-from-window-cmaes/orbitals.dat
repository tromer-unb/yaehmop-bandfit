# index  atom  orbital  l  m   (YAeHMOP order; spinor basis: these n spin up, then spin down)
     1  In1      s            0  0
     2  In1      px           1  1
     3  In1      py           1 -1
     4  In1      pz           1  0
     5  In2      s            0  0
     6  In2      px           1  1
     7  In2      py           1 -1
     8  In2      pz           1  0
     9  S3       s            0  0
    10  S3       px           1  1
    11  S3       py           1 -1
    12  S3       pz           1  0
    13  S4       s            0  0
    14  S4       px           1  1
    15  S4       py           1 -1
    16  S4       pz           1  0
