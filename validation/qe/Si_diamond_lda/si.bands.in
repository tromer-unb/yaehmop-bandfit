&CONTROL
   prefix = 'si'
   calculation = 'bands'
   restart_mode = 'from_scratch'
   wf_collect = .false.
   outdir = './'
   wfcdir = './'
   pseudo_dir = '../../../Pseudos/'
   tstress = .true.
   tprnfor = .true.
/
&SYSTEM
   ibrav = 2
   celldm(1) = 10.20
   nat = 2
   ntyp = 1
   nbnd = 8
   ecutwfc = 80
   ecutrho = 640
/
