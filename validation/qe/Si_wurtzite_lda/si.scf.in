&CONTROL
   prefix = 'si'
   calculation = 'scf'
   restart_mode = 'from_scratch'
   wf_collect = .false.
   outdir = './'
   wfcdir = './'
   pseudo_dir = '../../../Pseudos/'
   tstress = .true.
   tprnfor = .true.
/
&SYSTEM
   ibrav = 4
   celldm(1) = 7.1809
   celldm(3) = 1.6537
   nat = 4
   ntyp = 1
   ecutwfc = 30
   ecutrho = 240
/
 &ELECTRONS
   electron_maxstep = 100
   conv_thr = 1.0d-10
   mixing_mode = 'plain'
   mixing_beta = 0.7
   mixing_ndim = 8
   diagonalization = 'david'
   diago_david_ndim = 4
   diago_full_acc = .false.
/
ATOMIC_SPECIES
  Si   28.0855  Si.pz-n-rrkjus_psl.0.1.UPF
ATOMIC_POSITIONS crystal
  Si  0.00000   0.00000   0.00000
  Si  0.66667   0.33333   0.12500
  Si  0.66667   0.33333   0.50000
  Si  0.00000   0.00000   0.62500
K_POINTS automatic 
8 8 5  0 0 0
