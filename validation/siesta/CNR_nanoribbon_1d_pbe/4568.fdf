SystemName            4568CNR
SystemLabel           CNR

#..............................................
#            Species and Atons
#..............................................
NumberOfAtoms              68
NumberOfSpecies            2
%block Chemical_Species_label
  1   6   C
  2   1   H
%endblock Chemical_Species_label

#..............................................
#                Lattice
#..............................................


LatticeConstant 1.0 Ang

%block LatticeVectors
       16.459798    0.000000    0.000000
        0.000000   40.000000    0.000000
        0.000000    0.000000   40.000000
%endblock LatticeVectors

#..............................................
#                Band
#..............................................

BandLinesScale      ReciprocalLatticeVectors
%block BandLines
1     0.0000  0.0000  0.0000  \Gamma
100   0.5000  0.0000  0.0000  X
%endblock BandLines


#..............................................
#               K-points
#..............................................

%block kgrid_Monkhorst_Pack
20     0      0    0.5
0      1      0    0.5 
0      0      1    0.5
%endblock kgrid_Monkhorst_Pack

#..............................................
#                  PAO
#..............................................  
        
PAO.BasisType              split        
PAO.BasisSize              DZP                 #  Esses três comandos são redundantes, se     
PAO.EnergyShift            0.01  Ry            #  não estiverem especificados o siesta
PAO.SplitNorm              0.15                #  os coloca automaticamente com seus valores padrões 

#.............................................
#              Approximation
#.............................................     

SpinPolarized             F             
MeshCutoff                700.0  Ry       
xc.functional      	  GGA    
xc.authors         	  PBE	
#.............................................
#               SCF options
#.............................................

Harris.Functional         F                    #
SCF.MustConverge          F                    #
DM.PulayOnFile            F                    #
MaxSCFIterations          1000
DM.NumberPulay            5
DM.MixingWeight           0.10          
DM.Tolerance              1.d-5
DM.UseSaveDM              yes
NeglNonOverlapInt         false         
SolutionMethod            Diagon        
ElectronicTemperature     0.0019 Ry
                             
#.............................................
#               MD options
#.............................................
  
MD.TypeOfRun              CG 
MD.VariableCell           T                                               
MD.NumCGsteps             1000                                             
MD.MaxCGDispl             0.1 Bohr                                        
MD.MaxForceTol            0.0010 eV/Ang                                    
MD.InitialTimeStep        1            
MD.FinalTimeStep          500          
MD.LengthTimeStep         1.d0 fs                           
MD.TargetPressure         0.0   Ry/Bohr**3 
MD.MaxStressTol           0.0001 eV/Ang**3 
MD.UseSaveXV              T  


#............................................
#                Write
#............................................


WriteSiestaDim            F           
WriteMullikenPop          1 
WriteCoorXmol             T             
WriteMDXmol               T
WriteCoorStep             F  


#............................................
#                Y Z
#............................................
%block GeometryConstraints
   stress 2 3 4 5 6
%endblock GeometryConstraints

#..............................................
#         Atomic coordinates
#..............................................


AtomicCoordinatesFormat  ScaledByLatticeVectors  
                                                                                                                            
